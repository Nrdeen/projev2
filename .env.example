# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Authentication & security (see README of phase 1) ---
# SESSION_SECRET: REQUIRED in production, >= 32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real value; set it in the hosting platform's secret manager.
SESSION_SECRET=""

# ALLOWED_ORIGINS: comma-separated origins allowed to call mutating APIs / open WebSockets.
# APP_URL is added automatically. Example: https://souq.example.com
ALLOWED_ORIGINS=""

# TRUST_PROXY: number of reverse-proxy hops in front of the app (0 = none, 1 = e.g. Cloud Run / one load balancer).
TRUST_PROXY="0"

# SESSION_IDLE_DAYS / SESSION_MAX_DAYS: idle and absolute session lifetime (defaults 7 / 30).
#
# DATA_DIR: where store.json lives (default ./data). One running server (or one manage-users command) owns a
# data directory at a time: it is locked via DATA_DIR/.store.lock. The server and the CLI both read this value.
#
# How this file is used: `npm run dev` / `npm run start` / `npm run user:*` load ".env" automatically (never when
# the code is imported by tests). Variables already set in the real environment (hosting platform secrets) always
# win over the file. Keep ".env" out of Git and private to you: chmod 600 .env

# Development only: create demo accounts with random one-time passwords printed to the console.
# Ignored when NODE_ENV=production.
DEMO_ACCOUNTS="false"
