{
  // Backend + tooling: server.ts, server/, scripts/, tests/ and vite.config.ts run in Node, so they get
  // Node types and NO DOM types. The React frontend has its own config in src/tsconfig.json.
  // Type-check both with: npm run lint
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["server.ts", "server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
